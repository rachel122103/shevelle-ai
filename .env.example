# ============================================================
# Shevelle AI - Variables de entorno
# COPIA este archivo y renombralo a ".env" para empezar.
# El archivo ".env" NUNCA se sube a Git (esta en .gitignore).
# ============================================================

# --- Llave de la inteligencia artificial (OBLIGATORIA para usar la IA) ---
# Obtener una gratis en: https://platform.openai.com/api-keys
# Si la dejas vacia, la app funciona igual en "modo demostracion".
AI_API_KEY=your_api_key_here

# URL de la API (compatible con OpenAI). Cambiala si usas otro proveedor.
AI_API_URL=https://api.openai.com/v1/chat/completions

# Modelo de IA que se usara.
AI_MODEL=gpt-4o-mini

# Ajustes de la IA (opcionales, no los cambies si no sabes para que son).
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=700
AI_TIMEOUT=30

# --- Servidor web (opcional) ---
HOST=127.0.0.1
PORT=5000
DEBUG=true
SECRET_KEY=shevelle-ai-clave-de-desarrollo

# --- Informacion del negocio (opcional) ---
BUSINESS_NAME=Shevelle Beauty
BUSINESS_OWNER=
CURRENCY=RD$

# Alerta de inventario bajo: avisa cuando queden esta cantidad o menos.
LOW_STOCK_THRESHOLD=3
